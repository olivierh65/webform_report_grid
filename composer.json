{
  "name": "drupal/webform_report_grid",
  "type": "drupal-module",
  "description": "Generic drag-and-drop grid reports over submissions of any webform.",
  "license": "GPL-2.0-or-later",
  "require": {
    "phpoffice/phpspreadsheet": "^1.29 || ^2.0 || ^3.0"
  },
  "require-dev": {
    "drupal/core-dev": "^10 || ^11",
    "phpunit/phpunit": "^9.6"
  },
  "minimum-stability": "stable",
  "prefer-stable": true,
  "config": {
    "allow-plugins": {
      "phpstan/extension-installer": true,
      "dealerdirect/phpcodesniffer-composer-installer": true,
      "php-http/discovery": true
    }
  }
}
